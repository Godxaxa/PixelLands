{
  "expo": {
    "name": "frontend",
    "slug": "frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "frontend",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.emergent.pixellandmvp.fyi2me",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Selecionar fotos e vídeos para a galeria do seu universo",
        "NSPhotoLibraryAddUsageDescription": "Salvar mídias na sua galeria"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.emergent.pixellandmvp.fyi2me",
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "READ_MEDIA_IMAGES",
        "READ_MEDIA_VIDEO"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000"
        }
      ],
      "expo-video",
      [
        "expo-image-picker",
        {
          "photosPermission": "Selecionar fotos e vídeos para a galeria do seu universo",
          "cameraPermission": "Capturar fotos e vídeos para o seu universo"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
